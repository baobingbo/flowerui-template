# ===================== FlowerUI 前端模板 .gitignore =====================
# 本文件用于 flowerui-template（FlowerUI 前端独立仓库）。
# 核心原则：源码与配置入库，依赖 / 构建产物 / 运行时产物 / 密钥 一律不入库。

# ---------- 依赖（体积大，不入库） ----------
node_modules/
.pnp/
.pnp.js
.yarn/

# ---------- 构建产物（由 npm run build 生成，不入库） ----------
dist/
dist-*/
build/
.output/
.vite/
*.local

# ---------- 运行时日志与 PID（manage.sh 生成，不入库） ----------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.pid
*.pid.lock
_vite.pid

# ---------- 环境变量（含密钥，禁止入库；仅保留示例） ----------
.env
.env.*
!.env.example

# ---------- 编辑器 / 系统 / OS ----------
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# ---------- 测试 / 覆盖率 ----------
coverage/
.nyc_output/

# ---------- 缓存 ----------
.cache/
.eslintcache
.stylelintcache
*.tsbuildinfo
